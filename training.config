/*
 * training.config: snp_call_nf training session (Mali, 29 July 2026)
 *
 *     nextflow main.nf -c $SNPTRAIN/training.config
 *
 * Written for eight learners sharing one 128-thread server with no working
 * job scheduler, running the pipeline's bundled test data. Tested against
 * snp_call_nf main at commit 5386e4a.
 *
 * IMPORTANT: why everything is nested inside profiles.standard
 *
 * Nextflow parses nextflow.config, then this file, and THEN applies the
 * selected profile. Anything set at the top level here is overwritten by the
 * pipeline's own `standard` profile a moment later. Defining `standard` again
 * merges at the same level, and because this file is parsed second, these
 * values win.
 *
 * Symptom if you get this wrong: failures still retry five times and are then
 * ignored, and the Part 5 exercise has nothing to show.
 *
 * Using a different profile (e.g. -profile slurm)? Then these settings are
 * ignored. Copy the block below into a profile with that name instead, or
 * the pipeline's own settings for that profile will win.
 *
 * Adapting this for your own machine: change queueSize and the per-process
 * cpus/memory to fit your hardware and data. The test dataset is tiny; real
 * cohorts need far more memory for the GATK steps.
 */

profiles {

    standard {

        /* --- Failures must stop and be seen ---------------------------
         * The pipeline sets errorStrategy = { task.attempt < 5 ? 'retry'
         * : 'ignore' }. That is right for an unattended production run over
         * hundreds of samples, where one bad sample should not kill a
         * two-day job. It is wrong for a classroom: the learner waits
         * through five retries and then sees the run report success.
         * ------------------------------------------------------------- */

        process.errorStrategy = 'terminate'
        process.maxRetries    = 0

        /* --- Share the machine ---------------------------------------
         * queueSize caps concurrent tasks for ONE learner. Pipeline default
         * is 10; eight learners would be up to 80 at once.
         * 3 concurrent x 2 cpus x 8 learners = 48 of 128 threads, with ~50
         * already in use at baseline.
         * ------------------------------------------------------------- */

        executor {
            name         = 'local'
            queueSize    = 3
            pollInterval = 1.s
        }

        /* --- Per-process resources -----------------------------------
         * Test dataset is tiny. Pipeline defaults are 1 cpu / 10 GB, with
         * 10 cpus and 50 GB for the two joint-calling steps, sized for real
         * cohorts and far too much for eight people sharing one box.
         * ------------------------------------------------------------- */

        process {
            cpus   = 1
            memory = 4.GB

            withName: 'BOWTIE2.*' {
                cpus = 2
            }
            withName: SAMTOOLS_FASTQ {
                cpus = 2
            }
            withName: GATK_GENOMICS_DB_IMPORT {
                cpus   = 2
                memory = 8.GB
            }
            withName: GATK_GENOTYPE_GVCFS {
                cpus   = 2
                memory = 8.GB
            }
        }
    }
}
